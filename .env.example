# Copy to .env.local and fill in. Every value here is optional — without them
# the site runs exactly as it does today, recording orders to the server log.

# Public origin of the deployed site, no trailing slash. Sets the base for
# social preview images and canonical URLs. Defaults to the value in
# src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://vincents.com

# Emails each order, event quote and kitchen signup as it comes in.
# Get a key at https://resend.com. Leave unset to only record to the log.
RESEND_API_KEY=

# Optional overrides. ORDER_EMAIL_FROM must be on a domain verified with
# Resend; until you have one, leave it blank to use their test sender, which
# can only deliver to the address on your Resend account.
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=

# --- Admin dashboard (/admin) -------------------------------------------
# Postgres connection string. Without it the site runs exactly as before —
# orders are still taken, logged and emailed — but nothing is stored and the
# dashboard has nothing to report on.
# Easiest route: `vercel install neon`, then `vercel env pull .env.local`.
# Then create the tables with `npm run db:setup`.
DATABASE_URL=

# The password you type to reach /admin, and the secret its session cookie is
# signed with. Both must be set or every login is refused — an unset password
# never means "no password needed".
# Generate the secret with:  openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Fills the dashboard with invented orders so you can see how it works
# before real ones exist. Ignored the moment DATABASE_URL is set, and the
# dashboard shows a "sample data" banner the whole time it is on.
ADMIN_DEMO=
